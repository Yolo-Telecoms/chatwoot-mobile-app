{
  "name": "@chatwoot/mobile-app",
  "version": "4.0.0",
  "main": "./App.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "clean": "watchman watch-del-all && pnpm cache clean",
    "test": "jest",
    "lint": "eslint .",
    "generate": "npx expo prebuild --clean",
    "generate:soft": "npx expo prebuild",
    "run:ios": "npx expo run:ios -d",
    "run:android": "npx expo run:android -d",
    "build:android:dev": "dotenv -c -- cross-env NODE_ENV=development eas build -p android --profile development --local",
    "build:android:prod": "dotenv -c -- cross-env NODE_ENV=production eas build -p android --profile production",
    "build:android:local": "dotenv -c -- cross-env NODE_ENV=production eas build -p android --profile production --local",
    "build:ios:dev": "dotenv -c -- cross-env NODE_ENV=development eas build -p ios --profile development --local",
    "build:ios:prod": "dotenv -c -- cross-env NODE_ENV=production eas build -p ios --profile production",
    "build:ios:local": "dotenv -c -- cross-env NODE_ENV=production eas build -p ios --profile production --local",
    "build:all:local": "dotenv -c -- cross-env NODE_ENV=production eas build -p ios --profile production --local && dotenv -c -- cross-env NODE_ENV=production eas build -p android --profile production --local",
    "build:all": "dotenv -c -- cross-env NODE_ENV=production eas build -p ios --profile production && dotenv -c -- cross-env NODE_ENV=production eas build -p android --profile production",
    "submit:android": "dotenv -c -- eas submit -p android --profile production",
    "submit:ios": "dotenv -c -- eas submit -p ios --profile production",
    "submit:all": "dotenv -c -- eas submit -p ios --profile production && dotenv -c -- eas submit -p android --profile production",
    "storybook-generate": "sb-rn-get-stories",
    "storybook": "cross-env EXPO_STORYBOOK_ENABLED='true' expo start",
    "storybook:ios": "cross-env EXPO_STORYBOOK_ENABLED='true' pnpm run:ios",
    "storybook:android": "cross-env EXPO_STORYBOOK_ENABLED='true' expo android"
  },
  "dependencies": {
